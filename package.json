{
  "name": "rev-up",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rev Up — merge parts, race for cash and reputation, fill a showroom one earned car at a time.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playthrough": "vitest run tests/playthrough.test.ts --reporter verbose",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node scripts/smoke.mjs",
    "publish:pages": "node scripts/publish-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
